# The AI that makes the plans: claude (default) or gemini
LLM_PROVIDER=claude

# Claude (paid; Haiku costs cents a day)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# Gemini (optional, used when LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Usage limits for a publicly used key (set to false for private use)
AI_LIMITS_ENABLED=true
AI_DAILY_BUDGET_USD=1.50
AI_MESSAGES_PER_USER_PER_DAY=40
AI_MAX_MESSAGE_CHARS=1000
